     "line": 1746,
     "text": ""
    },
    {
     "line": 1747,
     "text": "    inst = _get_instrument_detail(stock_code)"
    },
    {
     "line": 1748,
     "text": "    if not inst:"
    },
    {
     "line": 1749,
     "text": "        return None"
    },
    {
     "line": 1750,
     "text": ""
    },
    {
     "line": 1751,
     "text": "    if iscomplete:"
    },
    {
     "line": 1752,
     "text": "        if 'ExtendInfo' in inst:"
    },
    {
     "line": 1753,
     "text": "            for field in inst['ExtendInfo']:"
    },
    {
     "line": 1754,
     "text": "                inst[field] = inst['ExtendInfo'][field]"
    },
    {
     "line": 1755,
     "text": "            del inst['ExtendInfo']"
    },
    {
     "line": 1756,
     "text": ""
    },
    {
     "line": 1757,
     "text": "        def convNum2Str(field):"
    },
    {
     "line": 1758,
     "text": "            if field in inst and isinstance(inst[field], int):"
    },
    {
     "line": 1759,
     "text": "                inst[field] = str(inst[field])"
    },
    {
     "line": 1760,
     "text": ""
    }
   ],
   "note": "get_instrument_detail 字段：PreClose/UpStopPrice(当日涨停价)/DownStopPrice(当日跌停价)/PriceTick(最小变价)/InstrumentStatus(停牌状态)——vendor instrument 事实字段存在，但语义为当日，历史窗口需另取。"
