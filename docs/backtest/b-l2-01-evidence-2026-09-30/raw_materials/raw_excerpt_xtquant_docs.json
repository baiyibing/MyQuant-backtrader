     "text": "  - order_type - int 委托类型"
    },
    {
     "line": 1031,
     "text": "  - order_volume - int 委托数量，股票以'股'为单位，债券以'张'为单位"
    },
    {
     "line": 1032,
     "text": "  - price_type - int 报价类型"
