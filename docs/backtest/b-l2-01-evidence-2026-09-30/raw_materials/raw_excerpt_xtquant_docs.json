     "text": "'high'                  #最高价"
    },
    {
     "line": 1225,
     "text": "'low'                   #最低价"
    },
    {
     "line": 1226,
     "text": "'close'                 #收盘价"
    },
    {
     "line": 1227,
     "text": "'volume'                #成交量"
    },
    {
     "line": 1228,
     "text": "'amount'                #成交额"
    },
    {
     "line": 1229,
     "text": "'settelementPrice'      #今结算"
    },
    {
     "line": 1230,
     "text": "'openInterest'          #持仓量"
    },
    {
     "line": 1231,
     "text": "'preClose'              #前收价"
    },
    {
     "line": 1232,
     "text": "'suspendFlag'           #停牌标记 0 - 正常 1 - 停牌 -1 - 当日起复牌"
