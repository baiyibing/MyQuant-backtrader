     "line": 1236,
     "text": ""
    },
    {
     "line": 1237,
     "text": "```python"
    },
    {
     "line": 1238,
     "text": "'interest'        \t\t#每股股利（税前，元）"
    },
    {
     "line": 1239,
     "text": "'stockBonus'      \t\t#每股红股（股）"
    },
    {
     "line": 1240,
     "text": "'stockGift'       \t\t#每股转增股本（股）"
    },
