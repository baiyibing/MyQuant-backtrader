  {
   "excerpt_id": "bt_ashare_session_limit_band",
   "original": "D:\\PycharmProjects\\MyQuant-backtrader\\backtest\\research\\ashare_session.py",
   "original_sha256": "52c8da5f425000a78fd6cbafca3c554a6efcb7e603d0d1c547c7d7a0835a7a91",
   "repo_head": "a268e11bc682cd1ae5a6672ab89091cea1abe937",
   "lines": [
    {
     "line": 1,
     "text": "# -*- coding: utf-8 -*-"
    },
    {
     "line": 2,
     "text": "\"\"\"A-share microstructure SSOT for daily and minute CSV engines."
    },
    {
     "line": 3,
     "text": ""
    },
    {
     "line": 4,
     "text": "Owns the facts every book must share and must not reimplement:"
    },
    {
     "line": 5,
     "text": ""
    },
    {
     "line": 6,
     "text": "- ST / board limit band (Decimal fen, fail-closed unknown prefix)"
    },
    {
     "line": 7,
     "text": "- official none 昨收 + E-R6 ex-div map"
    },
    {
     "line": 8,
     "text": "- limit-up skip / limit-down defer"
    },
    {
     "line": 9,
     "text": "- T+1 lot eligibility (``buy_date < session``)"
    },
    {
     "line": 10,
     "text": ""
    },
    {
     "line": 11,
     "text": "Strategy stops, ladders, and sizing stay in the book. This module must not"
    },
    {
     "line": 12,
     "text": "import a simulate loop or ``csv_ledger``."
    },
    {
     "line": 13,
     "text": "\"\"\""
    },
    {
     "line": 14,
     "text": ""
    },
    {
     "line": 15,
     "text": "from __future__ import annotations"
    },
    {
     "line": 16,
     "text": ""
    },
    {
     "line": 17,
     "text": "from datetime import date"
    },
    {
     "line": 18,
     "text": "from pathlib import Path"
    },
    {
     "line": 19,
     "text": "from typing import Iterable, Mapping"
    },
    {
     "line": 20,
     "text": ""
    },
    {
     "line": 21,
     "text": "from backtest.research.csv_pool import load_pool_names_by_day"
    },
    {
     "line": 22,
     "text": "from backtest.research.exdiv_map import k_for, load_exdiv_ratios, mapped_prev_close"
    },
    {
     "line": 23,
     "text": "from backtest.research.market_layer import is_st_name, limit_pct, limit_prices"
    },
    {
     "line": 24,
     "text": "from oskh_data.symbol_format import to_canonical_symbol"
    },
    {
     "line": 25,
     "text": ""
    },
    {
     "line": 26,
     "text": "LIMIT_EPS = 0.001"
    },
    {
     "line": 27,
     "text": ""
    },
    {
     "line": 28,
     "text": ""
    },
    {
     "line": 29,
     "text": "def hit_limit_up(price: float, limit_up: float) -> bool:"
    },
    {
     "line": 30,
     "text": "    \"\"\"买价达到或超过涨停价则不可买（含舍入导致买价高于算出的涨停价）。\"\"\""
    },
    {
     "line": 31,
     "text": "    return float(price) + LIMIT_EPS >= float(limit_up)"
    },
    {
     "line": 32,
     "text": ""
    },
    {
     "line": 33,
     "text": ""
    },
    {
     "line": 34,
     "text": "def hit_limit_down(price: float, limit_down: float) -> bool:"
    },
    {
     "line": 35,
     "text": "    \"\"\"卖价达到或低于跌停价则不可卖。\"\"\""
    },
    {
     "line": 36,
     "text": "    return float(price) - LIMIT_EPS <= float(limit_down)"
    },
    {
     "line": 37,
     "text": ""
    },
    {
     "line": 38,
     "text": ""
    },
    {
     "line": 39,
     "text": "def t1_sellable(buy_date: date, session: date) -> bool:"
    },
    {
     "line": 40,
     "text": "    \"\"\"A-share T+1: a lot is sellable only on a later session than ``buy_date``.\"\"\""
    },
    {
     "line": 41,
     "text": "    return buy_date < session"
    },
    {
     "line": 42,
     "text": ""
    },
    {
     "line": 43,
     "text": ""
    },
    {
     "line": 44,
     "text": "def raw_prev_close(closes: Mapping[date, float], today: date) -> float | None:"
    },
    {
     "line": 45,
     "text": "    prior = [day for day in closes if day < today]"
    },
    {
     "line": 46,
     "text": "    return float(closes[max(prior)]) if prior else None"
    },
    {
     "line": 47,
     "text": ""
    },
    {
     "line": 48,
     "text": ""
    },
    {
     "line": 49,
     "text": "def session_prev_close("
    },
    {
     "line": 50,
     "text": "    closes: Mapping[date, float],"
    },
    {
     "line": 51,
     "text": "    today: date,"
    },
    {
     "line": 52,
     "text": "    symbol: str,"
    },
    {
     "line": 53,
     "text": "    exdiv: Mapping[str, Mapping[str, float]] | None,"
    },
    {
     "line": 54,
     "text": ") -> float | None:"
    },
    {
     "line": 55,
     "text": "    \"\"\"None 昨收：上一交易日收盘，除权日乘 E-R6 ``k``。\"\"\""
    },
    {
     "line": 56,
     "text": "    raw = raw_prev_close(closes, today)"
    },
    {
     "line": 57,
     "text": "    if raw is None:"
    },
    {
     "line": 58,
     "text": "        return None"
    },
    {
     "line": 59,
     "text": "    previous, _did_map = mapped_prev_close(exdiv, symbol, today.strftime(\"%Y%m%d\"), raw)"
    },
    {
     "line": 60,
     "text": "    return previous"
    },
    {
     "line": 61,
     "text": ""
    },
    {
     "line": 62,
     "text": ""
    },
    {
     "line": 63,
     "text": "def session_limit_prices("
    },
    {
     "line": 64,
     "text": "    code: str,"
    },
    {
     "line": 65,
     "text": "    previous: float | None,"
    },
    {
     "line": 66,
     "text": "    name: str = \"\","
    },
    {
     "line": 67,
     "text": "    as_of=None,"
    },
    {
     "line": 68,
     "text": ") -> tuple[float, float] | None:"
    },
    {
     "line": 69,
     "text": "    if previous is None:"
    },
    {
     "line": 70,
     "text": "        return None"
    },
    {
     "line": 71,
     "text": "    return limit_prices(code, previous, name, as_of=as_of)"
    },
    {
     "line": 72,
     "text": ""
    },
    {
     "line": 73,
     "text": ""
    },
    {
     "line": 74,
     "text": "def skip_buy_at_limit(price: float, limits: tuple[float, float] | None) -> bool:"
    },
    {
     "line": 75,
     "text": "    return limits is not None and hit_limit_up(price, limits[0])"
    },
    {
     "line": 76,
     "text": ""
    },
    {
     "line": 77,
     "text": ""
    },
    {
     "line": 78,
     "text": "def defer_sell_at_limit(price: float, limits: tuple[float, float] | None) -> bool:"
    },
    {
     "line": 79,
     "text": "    return limits is not None and hit_limit_down(price, limits[1])"
    },
    {
     "line": 80,
     "text": ""
    }
   ],
   "note": "本仓成交核档位/涨跌停命中通用模块(session_limit_prices 等)；Decimal 链与测试向量见 docs/backtest/engine-ashare-correctness.md。"
  }
 ]
